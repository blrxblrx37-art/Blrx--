# انسخ القيم إلى Environment Variables في Railway/الخادم، ولا تضعها داخل ZIP أو Git.
SECRET_KEY=ضع_قيمة_عشوائية_طويلة_وفريدة_هنا
DATA_ENCRYPTION_KEY=ضع_مفتاح_Fernet_مولد_بواسطة_cryptography_هنا
ADMIN_PASSWORD=ضع_كلمة_مرور_قوية_لأول_تشغيل
HOSTING_BOT_API_KEY=ضع_مفتاح_API_طويل_وفريد_إذا_كنت_تستخدم_بوت_الإدارة
DATA_ENCRYPTION_ENABLED=1
BLOCK_SENSITIVE_PROJECT_FILES=1
MAX_CONTENT_LENGTH=52428800
MAX_UPLOAD_FILES=20
MAX_ARCHIVE_FILES=2000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
MAX_DOWNLOAD_BYTES=209715200
MAX_COMPRESS_FILES=2000
MAX_COMPRESS_BYTES=209715200
GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW=60
SCRAPE_GET_LIMIT=120
SCRAPE_GET_WINDOW=60
MAX_ACTIVE_REQUESTS=120
TRUSTED_PROXY_HOPS=1
REQUIRE_HTTPS=1
# اكتب الدومينات المفصولة بفواصل، أو اتركها فارغة إذا كان Railway هو الذي يدير Host.
ALLOWED_HOSTS=
HSTS_PRELOAD=0
